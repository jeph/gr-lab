        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo speichert die Fotos und Videos, die du von deiner Kamera herunterlädst, in deiner Fotomediathek."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το GR Photo αποθηκεύει στη βιβλιοθήκη σας τις φωτογραφίες και τα βίντεο που κατεβάζετε από την κάμερα."
