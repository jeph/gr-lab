{
  "sourceLanguage" : "en",
  "strings" : {
    "NSBluetoothAlwaysUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo používá Bluetooth ke spárování s vaším fotoaparátem Ricoh GR, k jeho vyhledání poblíž, probuzení, zapnutí jeho Wi-Fi a k funkci dálkové spouště."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo bruger Bluetooth til at parre med dit Ricoh GR, finde det i nærheden, vække det, slå dets Wi-Fi til og fungere som fjernudløser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo verwendet Bluetooth, um sich mit deiner Ricoh GR zu koppeln, sie in der Nähe zu finden, sie aufzuwecken, ihr WLAN einzuschalten und als ihr Fernauslöser zu dienen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το GR Photo χρησιμοποιεί το Bluetooth για αντιστοίχιση με τη Ricoh GR σας, για να τη βρίσκει όταν είναι κοντά, να την ενεργοποιεί, να ανοίγει το Wi-Fi της και να λειτουργεί ως τηλεχειριστήριο κλείστρου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo uses Bluetooth to pair with your Ricoh GR, find it nearby, wake it, turn on its Wi-Fi and act as its remote shutter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo usa Bluetooth para emparejarse con tu Ricoh GR, encontrarla cerca, activarla, encender su Wi-Fi y hacer de disparador remoto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo käyttää Bluetoothia muodostaakseen parin Ricoh GR ‑kamerasi kanssa, löytääkseen sen lähistöltä, herättääkseen sen, kytkeäkseen sen Wi-Fin päälle ja toimiakseen sen kaukolaukaisimena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo utilise le Bluetooth pour se jumeler avec votre Ricoh GR, le détecter à proximité, le réveiller, activer son Wi-Fi et lui servir de télécommande."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A GR Photo Bluetooth-kapcsolaton párosítja a Ricoh GR kamerát, megkeresi a közelben, felébreszti, bekapcsolja a Wi-Fi-hálózatát, és távkioldóként működik hozzá."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo usa il Bluetooth per accoppiarsi con la tua Ricoh GR, trovarla nelle vicinanze, riattivarla, accenderne il Wi-Fi e farle da telecomando di scatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR PhotoはBluetoothを使用して、Ricoh GRとのペアリング、近くにあるカメラの検出、カメラの起動、カメラのWi-Fiの有効化、リモートシャッター操作を行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo는 Bluetooth를 사용하여 Ricoh GR과 페어링하고, 근처에서 카메라를 찾고, 카메라를 깨우고, 카메라의 Wi-Fi를 켜고, 리모트 셔터로 작동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo gebruikt Bluetooth om met je Ricoh GR te koppelen, de camera in de buurt te vinden en te wekken, de Wi-Fi ervan in te schakelen en de camera op afstand te ontspannen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo używa Bluetooth, aby sparować się z aparatem Ricoh GR, znajdować go w pobliżu, wybudzać go, włączać jego Wi-Fi i działać jako pilot migawki."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GR Photo utiliza o Bluetooth para emparelhar com a sua Ricoh GR, encontrá-la por perto, ativá-la, ligar o Wi-Fi dela e servir de disparador remoto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo использует Bluetooth, чтобы создать пару с камерой Ricoh GR, находить ее поблизости, выводить из режима ожидания, включать ее Wi-Fi и работать как пульт спуска затвора."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo använder Bluetooth för att parkoppla med din Ricoh GR, hitta den i närheten, väcka den, slå på dess Wi-Fi och fungera som fjärrutlösare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo ใช้บลูทูธเพื่อจับคู่กับ Ricoh GR ของคุณ ค้นหากล้องที่อยู่ใกล้เคียง ปลุกกล้อง เปิด Wi-Fi ของกล้อง และทำหน้าที่เป็นรีโมตชัตเตอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo, Ricoh GR kameranızla eşleşmek, onu yakınlarda bulmak, uyandırmak, Wi-Fi ağını açmak ve uzaktan deklanşör olarak çalışmak için Bluetooth’u kullanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo 使用蓝牙与你的 Ricoh GR 配对、在附近查找它、唤醒它、开启它的 Wi-Fi，并充当它的遥控快门。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo 會使用 Bluetooth 與你的 Ricoh GR 配對、尋找附近的相機、喚醒相機、開啟相機的 Wi-Fi，並作為遙控快門。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo se k fotoaparátu připojuje přes jeho vlastní Wi-Fi síť, aby mohlo procházet a stahovat fotky a videa a zobrazovat živý náhled."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo opretter forbindelse til dit kamera via kameraets eget Wi-Fi-netværk for at gennemse og downloade billeder og videoer og vise live view."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo verbindet sich über das eigene WLAN-Netzwerk der Kamera mit ihr, um Fotos und Videos anzusehen und herunterzuladen und ihren Live-View anzuzeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το GR Photo συνδέεται στην κάμερά σας μέσω του δικού της δικτύου Wi-Fi, για να βλέπετε και να κατεβάζετε φωτογραφίες και βίντεο και για τη ζωντανή προβολή της."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo connects to your camera over its own Wi-Fi network to browse and download photos and videos and to show its live view."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo se conecta a tu cámara por su propia red Wi-Fi para explorar y descargar fotos y vídeos y mostrar su vista en directo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo yhdistää kameraasi sen oman Wi-Fi-verkon kautta, jotta voit selata ja ladata kuvia ja videoita ja nähdä kameran live-kuvan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo se connecte à votre appareil photo via son propre réseau Wi-Fi pour parcourir et télécharger les photos et vidéos, et pour afficher sa visée directe."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A GR Photo a kamera saját Wi-Fi-hálózatán csatlakozik a kamerához, hogy böngészhesse és letölthesse a fotókat és videókat, és megjeleníthesse az élőképet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo si connette alla fotocamera tramite la sua rete Wi-Fi per sfogliare e scaricare foto e video e per mostrare il live view."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photoはカメラ自身のWi-Fiネットワークでカメラに接続し、写真や動画の閲覧とダウンロード、ライブビューの表示を行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo는 카메라의 자체 Wi-Fi 네트워크로 카메라에 연결하여 사진과 동영상을 둘러보고 다운로드하며 라이브 뷰를 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo maakt via het eigen Wi-Fi-netwerk van je camera verbinding om foto's en video's te bekijken en te downloaden en om de live view te tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo łączy się z aparatem przez jego własną sieć Wi-Fi, aby przeglądać i pobierać zdjęcia i filmy oraz wyświetlać podgląd na żywo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GR Photo liga-se à câmara através da rede Wi-Fi da própria câmara para ver e transferir fotos e vídeos e para mostrar a vista ao vivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo подключается к камере по ее собственной сети Wi-Fi, чтобы просматривать и загружать фото и видео и показывать Live View."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo ansluter till kameran via dess eget Wi-Fi-nätverk för att bläddra bland och hämta bilder och videor och för att visa kamerans livevisning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo เชื่อมต่อกับกล้องผ่านเครือข่าย Wi-Fi ของกล้องเอง เพื่อเรียกดูและดาวน์โหลดภาพและวิดีโอ และแสดงไลฟ์วิว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo, fotoğraflara ve videolara göz atıp onları indirmek ve canlı görüntüyü göstermek için kameranıza kendi Wi-Fi ağı üzerinden bağlanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo 通过相机自身的 Wi-Fi 网络与其连接，以便浏览和下载照片与影片，并显示实时取景。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo 會透過相機自己的 Wi-Fi 網路連接相機，以瀏覽和下載照片與影片，並顯示即時取景畫面。"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo posílá vaši polohu do fotoaparátu, dokud je fotoaparát zapnutý. Když polohu povolíte vždy, začne ji posílat také po zapnutí fotoaparátu, aniž byste GR Photo otevřeli, a v tomto zařízení uchovává 90denní historii polohy, podle které přidává polohu ke stahovaným fotkám. Vaše poloha se posílá jen do vašeho fotoaparátu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo sender din lokalitet til dit kamera, mens kameraet er tændt. Hvis du tillader altid, begynder appen også at sende, når du tænder kameraet uden at åbne GR Photo, og den gemmer 90 dages lokalitetshistorik på denne enhed for at føje lokalitet til de billeder, du downloader. Din lokalitet sendes kun til dit kamera."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo sendet deinen Standort an deine Kamera, solange die Kamera eingeschaltet ist. Wenn du „Immer“ erlaubst, beginnt das Senden auch dann, wenn du die Kamera einschaltest, ohne GR Photo zu öffnen, und GR Photo speichert auf diesem Gerät einen Standortverlauf der letzten 90 Tage, um den Fotos, die du herunterlädst, Standorte hinzuzufügen. Dein Standort geht nur an deine Kamera."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το GR Photo στέλνει την τοποθεσία σας στην κάμερα όσο η κάμερα είναι ενεργοποιημένη. Αν επιτρέψετε την πρόσβαση πάντα, αρχίζει επίσης να τη στέλνει όταν ενεργοποιείτε την κάμερα χωρίς να ανοίξετε το GR Photo, και διατηρεί σε αυτή τη συσκευή ιστορικό τοποθεσίας 90 ημερών για να προσθέτει τοποθεσία στις φωτογραφίες που κατεβάζετε. Η τοποθεσία σας στέλνεται μόνο στην κάμερά σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo sends your location to your camera while the camera is on. With Always, it also starts sending when you switch the camera on without opening GR Photo, and keeps a 90-day location history on this device to add locations to the photos you download. Your location goes only to your camera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo envía tu ubicación a la cámara mientras la cámara está encendida. Si la permites siempre, también empieza a enviarla cuando enciendes la cámara sin abrir GR Photo, y guarda en este dispositivo un historial de ubicaciones de 90 días para añadir la ubicación a las fotos que descargas. Tu ubicación solo se envía a tu cámara."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo lähettää sijaintisi kameraan, kun kamera on päällä. Jos sallit sijainnin aina, lähetys alkaa myös, kun kytket kameran päälle avaamatta GR Photoa, ja sovellus säilyttää tällä laitteella 90 päivän sijaintihistoriaa lisätäkseen sijainnin lataamiisi kuviin. Sijaintisi lähetetään vain kameraasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo envoie votre position à votre appareil photo tant que celui-ci est allumé. Si vous l’autorisez toujours, l’envoi commence aussi lorsque vous allumez l’appareil sans ouvrir GR Photo, et l’app conserve sur cet appareil un historique de positions de 90 jours pour ajouter le lieu aux photos que vous téléchargez. Votre position n’est envoyée qu’à votre appareil photo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A GR Photo elküldi a tartózkodási helyét a kamerának, amíg a kamera be van kapcsolva. Ha mindig engedélyezi, akkor is elkezdi küldeni, amikor a GR Photo megnyitása nélkül kapcsolja be a kamerát, és ezen az eszközön 90 napos helyelőzményt őriz, hogy helyadatot adjon a letöltött fotókhoz. A tartózkodási helyét csak a kamerája kapja meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo invia la tua posizione alla fotocamera mentre la fotocamera è accesa. Se la consenti sempre, inizia a inviarla anche quando accendi la fotocamera senza aprire GR Photo, e conserva su questo dispositivo una cronologia delle posizioni di 90 giorni per aggiungere la posizione alle foto che scarichi. La tua posizione viene inviata solo alla tua fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photoは、カメラの電源が入っている間、あなたの位置情報をカメラに送信します。「常に」を許可すると、GR Photoを開かずにカメラの電源を入れたときにも送信を開始し、ダウンロードする写真に位置情報を追加するために90日分の位置情報の履歴をこのデバイスに保存します。位置情報はあなたのカメラにのみ送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo는 카메라가 켜져 있는 동안 사용자의 위치를 카메라로 보냅니다. ‘항상’을 허용하면 GR Photo를 열지 않고 카메라를 켤 때도 전송을 시작하며, 다운로드하는 사진에 위치를 추가하기 위해 90일간의 위치 기록을 이 기기에 보관합니다. 위치는 사용자의 카메라로만 전송됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo stuurt je locatie naar je camera zolang de camera aan staat. Als je 'Altijd' toestaat, begint het versturen ook wanneer je de camera aanzet zonder GR Photo te openen, en bewaart GR Photo op dit apparaat een locatiegeschiedenis van 90 dagen om locaties toe te voegen aan de foto's die je downloadt. Je locatie gaat alleen naar je camera."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo wysyła Twoją lokalizację do aparatu, gdy aparat jest włączony. Jeśli zezwolisz zawsze, zacznie ją wysyłać także po włączeniu aparatu bez otwierania GR Photo i będzie przechowywać na tym urządzeniu 90-dniową historię lokalizacji, aby dodawać lokalizację do pobieranych zdjęć. Twoja lokalizacja trafia wyłącznie do Twojego aparatu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GR Photo envia a sua localização para a câmara enquanto a câmara está ligada. Se permitir sempre, também começa a enviá-la quando liga a câmara sem abrir o GR Photo, e guarda neste dispositivo um histórico de localização de 90 dias para adicionar a localização às fotos que transfere. A sua localização é enviada apenas para a sua câmara."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo отправляет вашу геопозицию на камеру, пока камера включена. Если разрешить доступ всегда, отправка начнётся и тогда, когда вы включите камеру, не открывая GR Photo, а на этом устройстве будет храниться история геопозиции за 90 дней, чтобы добавлять место съёмки к загружаемым фото. Ваша геопозиция отправляется только на вашу камеру."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo skickar din plats till kameran medan kameran är på. Om du tillåter alltid börjar appen också skicka när du slår på kameran utan att öppna GR Photo, och den sparar 90 dagars platshistorik på den här enheten för att lägga till plats i de bilder du hämtar. Din plats skickas bara till din kamera."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo ส่งตำแหน่งที่ตั้งของคุณไปยังกล้องขณะที่กล้องเปิดอยู่ หากคุณอนุญาตตลอดเวลา แอปจะเริ่มส่งเมื่อคุณเปิดกล้องโดยไม่ต้องเปิด GR Photo ด้วย และจะเก็บประวัติตำแหน่งที่ตั้ง 90 วันไว้ในอุปกรณ์นี้เพื่อเพิ่มตำแหน่งที่ตั้งให้กับรูปภาพที่คุณดาวน์โหลด ตำแหน่งที่ตั้งของคุณจะถูกส่งไปยังกล้องของคุณเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo, kamera açıkken konumunuzu kameranıza gönderir. Her zaman izin verirseniz, GR Photo’yu açmadan kamerayı açtığınızda da göndermeye başlar ve indirdiğiniz fotoğraflara konum eklemek için bu aygıtta 90 günlük konum geçmişi tutar. Konumunuz yalnızca kameranıza gönderilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机开机期间，GR Photo 会将你的位置发送到相机。如果你允许“始终”，在你未打开 GR Photo 而打开相机时也会开始发送，并在此设备上保存 90 天的位置历史记录，以便为你下载的照片添加位置。你的位置只会发送到你的相机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相機開機期間，GR Photo 會將你的位置傳送到相機。如果你允許「永遠」，在你未打開 GR Photo 而開啟相機時也會開始傳送，並在此裝置上保存 90 天的位置記錄，以便為你下載的照片加入位置。你的位置只會傳送到你的相機。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo posílá vaši polohu přes Bluetooth do fotoaparátu, dokud je fotoaparát zapnutý, aby ji fotoaparát mohl ukládat do pořízených fotek. Vaše poloha se posílá jen do vašeho fotoaparátu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo sender din lokalitet til dit kamera via Bluetooth, mens kameraet er tændt, så kameraet kan gemme den i de billeder, du tager. Din lokalitet sendes kun til dit kamera."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo sendet deinen Standort über Bluetooth an deine Kamera, solange die Kamera eingeschaltet ist, damit die Kamera ihn in den Fotos speichern kann, die du aufnimmst. Dein Standort geht nur an deine Kamera."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το GR Photo στέλνει την τοποθεσία σας στην κάμερα μέσω Bluetooth όσο η κάμερα είναι ενεργοποιημένη, ώστε η κάμερα να την αποθηκεύει στις φωτογραφίες που τραβάτε. Η τοποθεσία σας στέλνεται μόνο στην κάμερά σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo sends your location to your camera over Bluetooth while the camera is on, so the camera can save it in the photos you take. Your location goes only to your camera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo envía tu ubicación a la cámara por Bluetooth mientras la cámara está encendida, para que la cámara pueda guardarla en las fotos que haces. Tu ubicación solo se envía a tu cámara."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo lähettää sijaintisi kameraan Bluetoothin kautta, kun kamera on päällä, jotta kamera voi tallentaa sen ottamiisi kuviin. Sijaintisi lähetetään vain kameraasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo envoie votre position à votre appareil photo par Bluetooth tant que celui-ci est allumé, afin que l’appareil puisse l’enregistrer dans les photos que vous prenez. Votre position n’est envoyée qu’à votre appareil photo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A GR Photo Bluetooth-on elküldi a tartózkodási helyét a kamerának, amíg a kamera be van kapcsolva, hogy a kamera elmenthesse a készített fotókba. A tartózkodási helyét csak a kamerája kapja meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo invia la tua posizione alla fotocamera tramite Bluetooth mentre la fotocamera è accesa, così la fotocamera può salvarla nelle foto che scatti. La tua posizione viene inviata solo alla tua fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photoは、カメラの電源が入っている間、Bluetoothであなたの位置情報をカメラに送信し、カメラが撮影した写真に位置情報を保存できるようにします。位置情報はあなたのカメラにのみ送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo는 카메라가 켜져 있는 동안 Bluetooth로 사용자의 위치를 카메라로 보내 카메라가 촬영한 사진에 위치를 저장할 수 있게 합니다. 위치는 사용자의 카메라로만 전송됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo stuurt je locatie via Bluetooth naar je camera zolang de camera aan staat, zodat de camera die kan bewaren in de foto's die je maakt. Je locatie gaat alleen naar je camera."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo wysyła Twoją lokalizację do aparatu przez Bluetooth, gdy aparat jest włączony, aby aparat mógł zapisywać ją w robionych zdjęciach. Twoja lokalizacja trafia wyłącznie do Twojego aparatu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GR Photo envia a sua localização para a câmara por Bluetooth enquanto a câmara está ligada, para que a câmara a possa guardar nas fotos que tira. A sua localização é enviada apenas para a sua câmara."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo отправляет вашу геопозицию на камеру по Bluetooth, пока камера включена, чтобы камера могла сохранять её в снимках. Ваша геопозиция отправляется только на вашу камеру."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo skickar din plats till kameran via Bluetooth medan kameran är på, så att kameran kan spara den i de bilder du tar. Din plats skickas bara till din kamera."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo ส่งตำแหน่งที่ตั้งของคุณไปยังกล้องผ่านบลูทูธขณะที่กล้องเปิดอยู่ เพื่อให้กล้องบันทึกตำแหน่งที่ตั้งลงในรูปภาพที่คุณถ่ายได้ ตำแหน่งที่ตั้งของคุณจะถูกส่งไปยังกล้องของคุณเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo, kamera açıkken konumunuzu Bluetooth üzerinden kameranıza gönderir; böylece kamera çektiğiniz fotoğraflara konumu kaydedebilir. Konumunuz yalnızca kameranıza gönderilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机开机期间，GR Photo 会通过蓝牙将你的位置发送到相机，以便相机将位置存入你拍摄的照片。你的位置只会发送到你的相机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相機開機期間，GR Photo 會透過藍牙將你的位置傳送到相機，讓相機將位置存入你拍攝的照片。你的位置只會傳送到你的相機。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GR Photo ukládá fotky a videa stažené z fotoaparátu do vaší knihovny fotek."
