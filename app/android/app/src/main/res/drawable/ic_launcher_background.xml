<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon's light grey ground, the "ground" gradient of app/icon/icon.svg.
     It runs across the middle 72 dp of the 108 dp layer, the part a launcher
     shows, as the iOS icon's does. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="0"
                android:endY="90"
                android:startX="0"
                android:startY="18"
                android:type="linear">
                <item android:color="#FFECECEF" android:offset="0" />
                <item android:color="#FFC6C7CD" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
